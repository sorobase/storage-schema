---
// SPDX-License-Identifier: Apache-2.0
// Starlight SiteTitle override: the project monogram (ticket prefix in mono on
// the accent wash) followed by the site title, same as the app header.
// Register in astro.config.mjs:
//   starlight({ components: { SiteTitle: './src/components/kit/SiteTitle.astro' } })
// Set CODE to the project's ticket prefix from design/projects.json.
const CODE = 'SSC';
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="sik-site-title">
  <span class="sik-monogram" aria-hidden="true">{CODE}</span>
  <span class="sik-site-name" translate="no">{siteTitle}</span>
</a>

<style>
  .sik-site-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    color: var(--sik-ink);
    font-size: var(--sik-text-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }
  .sik-monogram {
    display: inline-grid;
    place-items: center;
    flex: none;
    height: 2rem;
    min-width: 2rem;
    padding: 0 0.375rem;
    border: 1px solid color-mix(in oklab, var(--sik-accent) 25%, transparent);
    border-radius: var(--sik-radius-xs);
    background: var(--sik-accent-wash);
    color: var(--sik-accent);
    font-family: var(--sik-font-mono);
    font-size: 11px;
    font-weight: 600;
  }
  .sik-site-name { overflow: hidden; text-overflow: ellipsis; }
</style>
